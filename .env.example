# Copy to .env — never commit the real one. Secrets stay in env/vault.
BUSINESS_CONFIG=knowledge/ev_charger_install_en.yaml
DEFAULT_LOCALE=en-GB
SUPPORT_DB=runtime/support.db
# LLM: provider presets meta|openai|custom (explicit LLM_BASE_URL wins).
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
MODEL_API_KEY=
LLM_MODEL=
# Voice + telephony
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-GB-RyanNeural
QWEN_API_KEY=
QWEN_MODEL=qwen-audio-3.0-realtime-plus
QWEN_VOICE=Tina
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TELNYX_API_KEY=
# Sparky actions: comma-separated per-sparky keys; empty = open dev mode.
SPARKY_API_KEYS=
# IT tools: exact process names allowed to restart (default-deny when empty).
IT_RESTART_ALLOWLIST=
# Suppliers + messaging (all optional; stubs log locally without them)
SUPPLIER_MCP_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
META_PAGE_TOKEN=
META_PAGE_ID=
SMTP_HOST=
RESEND_API_KEY=
# Retention (days): cases, escalated extra, uploads, tts, logs, db
RETAIN_CASE_DAYS=90
RETAIN_ESCALATED_EXTRA_DAYS=90
RETAIN_UPLOAD_DAYS=30
RETAIN_TTS_DAYS=7
RETAIN_LOG_DAYS=180
RETAIN_DB_DAYS=365
